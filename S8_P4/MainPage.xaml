<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="S8_P4.MainPage">
    <StackLayout Padding="30" Spacing="15">
        <Label Text="Operaciones de Dos Números"
               FontSize="30"
               FontAttributes="Bold"
               TextColor="DarkBlue"
               HorizontalOptions="CenterAndExpand"
               VerticalOptions="CenterAndExpand" />
        <Entry x:Name="txtNumero1"
               Placeholder="Número 1"
               HorizontalOptions="CenterAndExpand" />
        <Entry x:Name="txtNumero2"
               Placeholder="Número 2"
               HorizontalOptions="CenterAndExpand" />
        <Button Text="Sumar"
                BackgroundColor="LightBlue"
                TextColor="Red"
                FontAttributes="Bold"
                Clicked="Sumar_Clicked"
                HorizontalOptions="CenterAndExpand" />
        <Button Text="Restar"
        Clicked="Restar_Clicked"
                BackgroundColor="LightBlue"
                TextColor="Red"
                FontAttributes="Bold"
        HorizontalOptions="CenterAndExpand" />
        <Button Text="Multiplicar"
              BackgroundColor="LightBlue"
              TextColor="Red"
                FontAttributes="Bold"
        Clicked="Multiplicar_Clicked"
        HorizontalOptions="CenterAndExpand" />

        <Button Text="Dividir"
             BackgroundColor="LightBlue"
             TextColor="Red"
                FontAttributes="Bold"
        Clicked="Dividir_Clicked"
        HorizontalOptions="CenterAndExpand" />
        
        <Label x:Name="lblResultado"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="Green"
               HorizontalOptions="CenterAndExpand"
               VerticalOptions="CenterAndExpand" />
    </StackLayout>
</ContentPage>